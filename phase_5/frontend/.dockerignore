# Phase 4: Frontend Docker Ignore
# Exclude files not needed in container build context

# Dependencies (will be installed fresh)
node_modules/

# Next.js build cache
.next/

# Environment files (secrets)
.env
.env.*
*.env
.env.local
.env.development
.env.production

# Testing
coverage/
.vitest/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Documentation
*.md
docs/

# Build artifacts
dist/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# TypeScript cache
*.tsbuildinfo

# Storybook
.storybook/
storybook-static/
