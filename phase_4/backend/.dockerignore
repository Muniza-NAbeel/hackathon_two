# Phase 4: Backend Docker Ignore
# Exclude files not needed in container build context

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
.env/

# Environment files (secrets)
.env
.env.*
*.env

# Testing
tests/
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Documentation
*.md
docs/

# Build artifacts
dist/
build/
*.egg-info/

# Alembic versions (managed separately)
# alembic/versions/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
