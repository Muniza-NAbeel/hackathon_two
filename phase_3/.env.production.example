# Phase 3 Production Environment Configuration
# Copy this file to .env.production and fill in your production values

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection string (Neon Serverless recommended)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech:5432/todo_db?sslmode=require"

# Database pool settings (for production)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ============================================================================
# Authentication & Security
# ============================================================================

# JWT Secret (MUST match Phase 2 - minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long"

# JWT Settings
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440  # 24 hours

# ============================================================================
# OpenAI Configuration
# ============================================================================

# OpenAI API Key (required for AI agent)
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# OpenAI Model Selection
OPENAI_MODEL="gpt-4"  # or "gpt-3.5-turbo" for cost savings
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=500

# ============================================================================
# MCP Server Configuration
# ============================================================================

# MCP Server URL (internal network in production)
MCP_SERVER_URL="http://mcp-server:8001"

# MCP Request Timeout (seconds)
MCP_TIMEOUT=30

# ============================================================================
# API Configuration
# ============================================================================

# CORS Settings (restrict to your frontend domain)
CORS_ORIGINS="https://your-app.com,https://www.your-app.com"
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=20

# API Base URL
API_BASE_URL="https://api.your-app.com"

# ============================================================================
# Frontend Configuration (Next.js)
# ============================================================================

# Next.js API URL
NEXT_PUBLIC_API_URL="https://api.your-app.com"

# ChatKit Domain Key (get from OpenAI Dashboard)
NEXT_PUBLIC_OPENAI_DOMAIN_KEY="your-chatkit-domain-key"

# Frontend URL (for callbacks)
NEXT_PUBLIC_APP_URL="https://your-app.com"

# ============================================================================
# Logging & Monitoring
# ============================================================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Log Format (json for production, text for development)
LOG_FORMAT="json"

# Sentry DSN (optional - for error tracking)
SENTRY_DSN=""

# ============================================================================
# Application Settings
# ============================================================================

# Environment
ENVIRONMENT="production"

# Debug Mode (MUST be false in production)
DEBUG=false

# ============================================================================
# Health Check Configuration
# ============================================================================

# Health check endpoints enabled
HEALTH_CHECK_ENABLED=true

# Health check database queries
HEALTH_CHECK_DB=true

# ============================================================================
# Performance & Scalability
# ============================================================================

# Worker processes (for Gunicorn/Uvicorn)
WORKERS=4

# Worker class
WORKER_CLASS="uvicorn.workers.UvicornWorker"

# Timeout for workers
TIMEOUT=60

# ============================================================================
# Security Headers
# ============================================================================

# Enable security headers
SECURITY_HEADERS_ENABLED=true

# Content Security Policy
CSP_ENABLED=true

# ============================================================================
# Backup & Maintenance
# ============================================================================

# Automated backup enabled
BACKUP_ENABLED=true

# Backup schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# Backup retention days
BACKUP_RETENTION_DAYS=30

# ============================================================================
# Feature Flags
# ============================================================================

# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable conversation analytics
ENABLE_ANALYTICS=true

# Enable performance monitoring
ENABLE_PERFORMANCE_MONITORING=true

# ============================================================================
# Third-Party Services (Optional)
# ============================================================================

# Redis (for caching and rate limiting)
REDIS_URL=""

# Email service (for notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@your-app.com"

# ============================================================================
# Notes
# ============================================================================

# 1. NEVER commit .env.production with real values to version control
# 2. Use environment-specific secrets management (AWS Secrets Manager, etc.)
# 3. Rotate JWT_SECRET and OPENAI_API_KEY regularly
# 4. Monitor API usage and costs
# 5. Set up alerting for errors and performance issues
# 6. Enable HTTPS only in production
# 7. Use managed PostgreSQL (Neon, AWS RDS, etc.) for reliability
# 8. Configure proper backup and disaster recovery
