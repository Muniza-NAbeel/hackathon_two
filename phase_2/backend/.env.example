# Phase II: Todo Full-Stack Web Application - Backend Environment Variables

# Database - Neon PostgreSQL (NO QUOTES!)
# Note: Do not include ?sslmode=require - asyncpg uses ssl=True in connect_args instead
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb

# Authentication - Better Auth Secret (min 32 characters, NO QUOTES!)
BETTER_AUTH_SECRET=your-super-secret-key-here-minimum-32-characters

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS - Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
