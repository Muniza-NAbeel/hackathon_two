# Phase II: Todo Full-Stack Web Application - Backend Environment Variables

# Database - Neon PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Authentication - Better Auth Secret (min 32 characters)
BETTER_AUTH_SECRET=your-super-secret-key-here-minimum-32-characters

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS - Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
